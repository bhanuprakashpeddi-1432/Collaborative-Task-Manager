# ──────────────────────────────────────────────────────────────────────────────
# WorkCollab — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in production secrets.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_NAME=workcollab
DB_USERNAME=workcollab
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure 256-bit base64 key:
#   openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_BASE64_ENCODED_SECRET
JWT_EXPIRATION_MS=86400000

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (use your production domain in prod)
WEBSOCKET_ALLOWED_ORIGINS=*
